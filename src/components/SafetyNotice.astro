---
interface Props {
  topics: Array<'heating' | 'power-equipment' | 'electrical' | 'chemical'>
}

const { topics } = Astro.props

const notices: Record<string, string> = {
  heating: 'Always maintain manufacturer-specified clearances from combustible materials. Never leave open flames or propane-fueled appliances unattended. Store propane cylinders upright in a well-ventilated outdoor area away from ignition sources.',
  'power-equipment': 'Wear eye protection and hearing protection when operating power equipment. Keep bystanders and pets clear of the work area. Read the manufacturer\'s safety manual before first use and follow all lockout/tagout procedures before servicing.',
  electrical: 'Verify the IP weatherproofing rating before installing any electrical fixture outdoors. Hardwired installations must be performed by a licensed electrician. Keep all connections and junction boxes away from standing water.',
  chemical: 'Read the full product label before applying any chemical repellent or pest control product. Keep children and pets away from treated areas until the product has fully dried. Dispose of empty containers according to local regulations.',
}
---

{topics.length > 0 && (
  <aside class="safety-notice" role="note" aria-label="Safety information">
    <p class="safety-notice__heading">Safety Note</p>
    <ul class="safety-notice__list">
      {topics.map(t => notices[t] && <li>{notices[t]}</li>)}
    </ul>
  </aside>
)}

<style>
  .safety-notice {
    background: #fffbeb;
    border-left: 4px solid #d97706;
    border-radius: 0 0.375rem 0.375rem 0;
    padding: 0.875rem 1.25rem;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }
  .safety-notice__heading {
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: #92400e;
  }
  .safety-notice__list {
    margin: 0;
    padding-left: 1.25rem;
    color: #78350f;
  }
  .safety-notice__list li + li {
    margin-top: 0.375rem;
  }
</style>
