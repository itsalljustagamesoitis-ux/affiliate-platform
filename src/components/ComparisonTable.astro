---
import type { ResolvedProduct } from '../lib/config'
import { productDisplayName } from '../lib/config'

interface Props {
  products: ResolvedProduct[]
  attributes?: string[]
}

const { products, attributes: attrsProp } = Astro.props

// Spec mode: when 2+ products carry `specs`, columns are the spec keys most of them share (max 4).
const specCounts = new Map<string, number>()
for (const p of products) for (const k of Object.keys(p.specs ?? {})) specCounts.set(k, (specCounts.get(k) ?? 0) + 1)
const specKeys = [...specCounts.entries()]
  .filter(([, n]) => n >= Math.max(2, Math.ceil(products.length / 2)))
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4)
  .map(([k]) => k)
const specMode = !attrsProp && products.filter(p => p.specs).length >= 2 && specKeys.length >= 2
const attributes = specMode ? specKeys.map(k => `spec:${k}`) : (attrsProp ?? ['price_band', 'pros', 'cons'])

const attrLabels: Record<string, string> = {
  price_band: 'Price Range',
  pros: 'Top Strength',
  cons: 'Key Weakness',
}

const priceBandLabel: Record<string, string> = {
  budget: '$',
  mid: '$$',
  premium: '$$$',
}
---

<div class="comparison-table-wrap">
  <table class="comparison-table">
    <thead>
      <tr>
        <th scope="col">Product</th>
        {attributes.map(attr => (
          <th scope="col">{attr.startsWith('spec:') ? attr.slice(5) : (attrLabels[attr] ?? attr)}</th>
        ))}
        <th scope="col">Buy</th>
      </tr>
    </thead>
    <tbody>
      {products.map(p => (
        <tr>
          <td>
            <strong>{productDisplayName(p)}</strong>
            {p.role && <span class="comparison-table__badge">{p.role.replace(/_/g, ' ')}</span>}
          </td>
          {attributes.map(attr => (
            <td>
              {attr === 'price_band' && priceBandLabel[p.price_band]}
              {attr === 'pros' && p.pros[0]}
              {attr === 'cons' && p.cons[0]}
              {attr.startsWith('spec:') && (p.specs?.[attr.slice(5)] ?? '—')}
            </td>
          ))}
          <td>
            {p.affiliate_url ? (
              <a
                href={p.affiliate_url}
                class={p.affiliate_url.includes('amazon.com') ? 'btn btn--amazon btn--sm' : 'btn btn--outline'}
                rel={p.affiliate_url.includes('amazon.com') ? 'nofollow sponsored noopener' : 'nofollow noopener'}
                target="_blank"
              >
                {p.affiliate_url.includes('amazon.com') ? 'Buy on Amazon' : 'Check Price'}
              </a>
            ) : '—'}
            {p.alt_offers?.length > 0 && (
              <div class="comparison-table__alt">
                {p.alt_offers.map((o) => (
                  <a href={o.url} class="btn btn--secondary btn--sm" rel="nofollow sponsored noopener" target="_blank" data-program={o.program}>{o.label}</a>
                ))}
              </div>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
