---
import { getSiteConfig, getNav } from '../lib/config'

const cfg = getSiteConfig()
const nav = getNav()
---

<header class="site-header">
  <div class="container--wide site-header__inner">
    {cfg.visual.logo_paths?.header_svg ? (
      <a href="/" class="site-header__logo" aria-label={cfg.site.brand_name}>
        <img src={cfg.visual.logo_paths.header_svg} alt={cfg.site.brand_name} class="site-header__logo-img" />
      </a>
    ) : (
      <a href="/" class="site-header__wordmark">
        {cfg.site.brand_name}
      </a>
    )}

    <nav aria-label="Main navigation" class="site-header__nav">
      <ul class="site-nav" id="main-nav">
        {nav.categories.map(cat => {
          const hasDropdown = cat.hubs.length > 1
          return (
            <li class={`site-nav__item ${hasDropdown ? 'has-dropdown' : ''}`}>
              <a href={`/${cat.slug}/`} class="site-nav__link">
                {cat.label}
                {hasDropdown && (
                  <svg class="site-nav__chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12">
                    <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                )}
              </a>
              {hasDropdown && (
                <ul class="site-nav__dropdown">
                  {cat.hubs.map(hub => (
                    <li><a href={`/${hub.slug}/`}>{hub.label}</a></li>
                  ))}
                  <li class="site-nav__dropdown-all">
                    <a href={`/${cat.slug}/`}>All {cat.label} →</a>
                  </li>
                </ul>
              )}
            </li>
          )
        })}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="/search/" class="site-header__search" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.75"/>
          <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  // ── Mobile hamburger toggle ───────────────────────────────────────────────
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement
  const nav = document.getElementById('main-nav')
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true'
    toggle.setAttribute('aria-expanded', String(!open))
    nav?.classList.toggle('is-open', !open)
  })

  // Close regular category dropdowns and More submenu when clicking outside
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-dropdown')) {
      document.querySelectorAll<HTMLElement>('.site-nav__dropdown').forEach(d => {
        d.style.display = ''
      })
    }
    if (!(e.target as Element).closest('.site-nav__more')) {
      document.querySelectorAll<HTMLElement>('.site-nav__more-list').forEach(list => {
        list.classList.remove('is-open')
      })
      document.querySelectorAll<HTMLButtonElement>('.site-nav__more-btn').forEach(btn => {
        btn.setAttribute('aria-expanded', 'false')
      })
    }
  })

  // ── Overflow "More" dropdown (desktop) ───────────────────────────────────
  function initOverflowNav() {
    if (window.innerWidth <= 900) return

    const navEl = document.getElementById('main-nav')
    if (!navEl) return

    const items = [...navEl.querySelectorAll<HTMLElement>(':scope > .site-nav__item:not(.site-nav__more)')]
    if (items.length === 0) return

    // Create the "More" list item once
    let moreItem = navEl.querySelector<HTMLElement>('.site-nav__more')
    if (!moreItem) {
      moreItem = document.createElement('li')
      moreItem.className = 'site-nav__item site-nav__more has-dropdown'
      moreItem.style.display = 'none'
      moreItem.innerHTML = `
        <button class="site-nav__link site-nav__more-btn" aria-expanded="false" aria-haspopup="true">
          More
          <svg class="site-nav__chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="site-nav__dropdown site-nav__more-list"></ul>
      `
      navEl.appendChild(moreItem)
    }

    const moreList = moreItem.querySelector<HTMLElement>('.site-nav__more-list')!
    const moreBtn = moreItem.querySelector<HTMLButtonElement>('.site-nav__more-btn')!

    // Toggle More submenu on click (click-only; CSS hover is suppressed for .site-nav__more-list)
    moreBtn.addEventListener('click', (e) => {
      e.stopPropagation()
      const isOpen = moreBtn.getAttribute('aria-expanded') === 'true'
      moreBtn.setAttribute('aria-expanded', String(!isOpen))
      moreList.classList.toggle('is-open', !isOpen)
    })

    // Escape closes submenu, returns focus to button
    ;[moreBtn, moreList].forEach(el => {
      el.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          moreList.classList.remove('is-open')
          moreBtn.setAttribute('aria-expanded', 'false')
          moreBtn.focus()
        }
      })
    })

    function remeasure() {
      if (window.innerWidth <= 900) {
        items.forEach(item => { item.style.display = '' })
        moreItem!.style.display = 'none'
        return
      }

      // Show all items, hide More button to measure natural widths
      items.forEach(item => { item.style.display = '' })
      moreItem!.style.display = 'none'

      const navWidth = navEl!.parentElement!.getBoundingClientRect().width
      const MORE_BTN_WIDTH = 90

      // Measure item widths while all are visible (forces synchronous layout)
      const itemWidths = items.map(item => item.getBoundingClientRect().width)
      const totalWidth = itemWidths.reduce((a, b) => a + b, 0)

      if (totalWidth <= navWidth) return  // everything fits, nothing to do

      // Find the cutoff: first item that doesn't fit once we reserve MORE_BTN_WIDTH.
      // Using a simple L→R sequential cutoff (items 0…cutoff-1 stay inline,
      // items cutoff…end all go to More) for predictable, contiguous grouping.
      const budget = navWidth - MORE_BTN_WIDTH
      let used = 0
      let cutoff = items.length

      for (let i = 0; i < items.length; i++) {
        if (used + itemWidths[i] > budget) {
          cutoff = i
          break
        }
        used += itemWidths[i]
      }

      // Atomically apply: visible items stay, overflow items go to More submenu
      moreList.innerHTML = ''
      for (let i = cutoff; i < items.length; i++) {
        items[i].style.display = 'none'
        const link = items[i].querySelector<HTMLAnchorElement>('.site-nav__link')
        if (!link) continue
        const li = document.createElement('li')
        const a = document.createElement('a')
        a.href = link.getAttribute('href') ?? '#'
        a.textContent = [...link.childNodes]
          .filter(n => n.nodeType === Node.TEXT_NODE)
          .map(n => n.textContent?.trim())
          .filter(Boolean)
          .join('')
        li.appendChild(a)
        moreList.appendChild(li)
      }

      moreItem!.style.display = ''
      moreBtn.setAttribute('aria-expanded', 'false')
      moreList.classList.remove('is-open')  // closed by default — click to open
    }

    remeasure()

    let resizeTimer: ReturnType<typeof setTimeout>
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer)
      resizeTimer = setTimeout(remeasure, 100)
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOverflowNav)
  } else {
    initOverflowNav()
  }
</script>

<style>
  .site-header__nav { flex: 1; min-width: 0; display: flex; justify-content: center; }

  .site-nav {
    display: flex; align-items: center; gap: 0;
    list-style: none; padding: 0; margin: 0;
  }

  .site-nav__item { position: relative; }

  .site-nav__link {
    display: flex; align-items: center; gap: 0.3rem;
    padding: 0 1rem; height: 64px;
    font-weight: 600; font-size: 0.875rem;
    color: var(--color-text); text-decoration: none;
    transition: color 0.15s;
    white-space: nowrap;
  }
  .site-nav__link:hover { color: var(--color-primary); }

  .site-nav__chevron { transition: transform 0.2s; flex-shrink: 0; }
  .site-nav__item:hover .site-nav__chevron { transform: rotate(180deg); }

  /* Dropdown */
  .site-nav__dropdown {
    display: none;
    position: absolute; top: 100%; left: 0;
    background: #fff;
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-primary);
    border-radius: 0 0 var(--radius) var(--radius);
    box-shadow: var(--shadow-md);
    list-style: none; padding: 0.5rem 0; margin: 0;
    min-width: 200px; z-index: 200;
  }
  .site-nav__item:hover .site-nav__dropdown { display: block; }

  .site-nav__dropdown li a {
    display: block; padding: 0.55rem 1.25rem;
    font-size: 0.875rem; color: var(--color-text);
    text-decoration: none; transition: background 0.1s, color 0.1s;
  }
  .site-nav__dropdown li a:hover { background: var(--color-surface-alt); color: var(--color-primary); }

  .site-nav__dropdown-all {
    border-top: 1px solid var(--color-border);
    margin-top: 0.25rem; padding-top: 0.25rem;
  }
  .site-nav__dropdown-all a { font-weight: 700; color: var(--color-primary) !important; }

  /* Search + actions */
  .site-header__actions { display: flex; align-items: center; gap: 0.75rem; }
  .site-header__search {
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 50%;
    color: var(--color-text); text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .site-header__search:hover { background: var(--color-surface-alt); color: var(--color-primary); }

  /* Mobile */
  @media (max-width: 900px) {
    .site-header__nav { display: none; }
    .nav-toggle { display: flex; }

    .site-header__nav.is-open {
      display: flex;
      position: fixed; top: 64px; left: 0; right: 0; bottom: 0;
      background: #fff; z-index: 150;
      flex-direction: column; padding: 1rem 1.5rem;
      overflow-y: auto;
      border-top: 2px solid var(--color-primary);
    }
    .site-nav { flex-direction: column; width: 100%; gap: 0; }
    .site-nav__link { height: auto; padding: 0.875rem 0; border-bottom: 1px solid var(--color-border); justify-content: space-between; width: 100%; }
    .site-nav__dropdown { display: block; position: static; box-shadow: none; border: none; border-top: none; padding: 0 0 0 1rem; }
    .site-nav__dropdown li a { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border); }
  }

  @media (min-width: 901px) {
    .nav-toggle { display: none; }
  }

  /* Text wordmark fallback (sites without a logo SVG) */
  .site-header__wordmark {
    font-weight: 700; font-size: 1.125rem;
    color: var(--color-text); text-decoration: none;
    white-space: nowrap;
  }
  .site-header__wordmark:hover { color: var(--color-primary); }

  /* "More" overflow button — desktop only */
  .site-nav__more-btn {
    background: none; border: none; cursor: pointer;
    font-family: inherit; font-weight: 600; font-size: 0.875rem;
  }
  .site-nav__more-btn:hover { color: var(--color-primary); }
  .site-nav__more .site-nav__dropdown { left: auto; right: 0; }

  /* More submenu: click-only. Override the generic hover rule so it stays
     closed until JS adds .is-open via the More button click handler. */
  .site-nav__more .site-nav__more-list { display: none; }
  .site-nav__more .site-nav__more-list.is-open { display: block; }
</style>
