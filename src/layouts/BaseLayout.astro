---
import { getSiteConfig, getPersona } from '../lib/config'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import { existsSync } from 'node:fs'
import { join } from 'node:path'

interface Props {
  title: string
  description: string
  canonicalUrl?: string
  ogImage?: string
  ogType?: 'website' | 'article'
  noindex?: boolean
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props

const cfg = getSiteConfig()
const persona = getPersona()

// GA4_ID env var overrides site.config.yaml — set per-clone in Cloudflare Pages
const ga4Id = import.meta.env.GA4_ID ?? cfg.analytics.ga4_measurement_id
const consentDefault = cfg.analytics.consent_default ?? 'denied'
const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION
const bingVerification = import.meta.env.BING_SITE_VERIFICATION
const cfAnalyticsToken = import.meta.env.CF_BEACON_TOKEN ?? (cfg.deployment as any)?.analytics_beacon_token
// Per-origin storage key — avoids brand coupling across clones
const consentKey = `${cfg.site.domain.replace(/\./g, '_')}_consent`

const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href
// OG image must be absolute for Facebook/Twitter parsers — construct from Astro.site
const ogImagePath = ogImage ?? `${cfg.images.base_url}/og-default.jpg`
const ogImageUrl = ogImagePath.startsWith('http') ? ogImagePath : new URL(ogImagePath, Astro.site).href

const cssVars = `
  --color-primary: ${cfg.visual.primary_color};
  --color-accent: ${cfg.visual.accent_color};
  --color-background: ${cfg.visual.background_color};
  --font-headings: '${cfg.visual.font_headings}', Georgia, serif;
  --font-body: '${cfg.visual.font_body}', system-ui, sans-serif;
`.trim()

// Self-hosted fonts — files are in each site's public/fonts/
const headSlug = cfg.visual.font_headings.toLowerCase().replace(/ /g, '-')
const bodySlug = cfg.visual.font_body.toLowerCase().replace(/ /g, '-')
const hasFontFile = (slug: string, wt: number, st: 'normal'|'italic') =>
  existsSync(join(process.cwd(), 'public', 'fonts', `${slug}-${wt}-${st}.woff2`))
const headWeights = [400, 600, 700].filter(w => hasFontFile(headSlug, w, 'normal'))
const headHasItalic = hasFontFile(headSlug, 400, 'italic')
const bodyWeights = [400, 500, 600].filter(w => hasFontFile(bodySlug, w, 'normal'))
const fontFaceCSS = [
  ...headWeights.map(w => `@font-face{font-family:'${cfg.visual.font_headings}';font-weight:${w};font-style:normal;font-display:swap;src:url('/fonts/${headSlug}-${w}-normal.woff2') format('woff2')}`),
  headHasItalic ? `@font-face{font-family:'${cfg.visual.font_headings}';font-weight:400;font-style:italic;font-display:swap;src:url('/fonts/${headSlug}-400-italic.woff2') format('woff2')}` : '',
  ...bodyWeights.map(w => `@font-face{font-family:'${cfg.visual.font_body}';font-weight:${w};font-style:normal;font-display:swap;src:url('/fonts/${bodySlug}-${w}-normal.woff2') format('woff2')}`),
].filter(Boolean).join('')

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={cfg.site.brand_name} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Self-hosted fonts (no third-party data transfer before consent) -->
    <style set:html={fontFaceCSS} />

    <!-- CSS custom properties from site config -->
    <style set:html={`:root { ${cssVars} }`} />

    <slot name="head" />

    <!-- Cloudflare Web Analytics -->
    {cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token":"${cfAnalyticsToken}"}`}
      />
    )}

    <!-- GA4 with Consent Mode v2 -->
    {ga4Id && (
      <>
        <script
          set:html={`
window.dataLayer=window.dataLayer||[];
function gtag(){dataLayer.push(arguments)}
gtag('consent','default',{analytics_storage:'${consentDefault}',ad_storage:'denied',wait_for_update:500});
gtag('js',new Date());
gtag('config','${ga4Id}',{anonymize_ip:true});
(function(){var _s=localStorage.getItem('${consentKey}');if(!_s)return;try{var _p=JSON.parse(_s);if(Date.now()-_p.timestamp>=365*24*60*60*1000){localStorage.removeItem('${consentKey}');return;}if(_p.value==='1')gtag('consent','update',{analytics_storage:'granted'});}catch(e){localStorage.removeItem('${consentKey}');}})();
`}
        />
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
      </>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <!-- Cookie consent banner -->
    {ga4Id && (
      <div id="cookie-banner"
           role="dialog"
           aria-modal="false"
           aria-label="Cookie consent"
           aria-describedby="cookie-banner-desc"
           data-key={consentKey}
           style="display:none;position:fixed;bottom:0;left:0;right:0;background:#1f2937;color:#f9fafb;padding:1rem 1.5rem;z-index:9999;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.875rem;">
        <p id="cookie-banner-desc" style="margin:0;flex:1 1 auto;">We use cookies to understand how visitors use this site. <a href="/privacy-policy/" style="color:var(--color-accent,#a3c97a);text-decoration:underline;">Privacy policy</a></p>
        <div style="display:flex;gap:.5rem;flex-shrink:0;">
          <button id="cookie-accept" style="background:var(--color-primary,#4a7c59);color:#fff;border:none;padding:.5rem 1rem;border-radius:4px;cursor:pointer;font-size:.875rem;font-weight:500;">Accept</button>
          <button id="cookie-decline" style="background:#52525b;color:#fff;border:none;padding:.5rem 1rem;border-radius:4px;cursor:pointer;font-size:.875rem;font-weight:500;">Decline</button>
        </div>
      </div>
    )}
    <script is:inline>
      (function(){
        var banner=document.getElementById('cookie-banner');
        if(!banner)return;
        var key=banner.dataset.key;
        var MAX_AGE=365*24*60*60*1000;
        function loadConsent(){
          var raw=localStorage.getItem(key);
          if(raw===null)return null;
          try{
            var p=JSON.parse(raw);
            if(Date.now()-p.timestamp>MAX_AGE){localStorage.removeItem(key);return null;}
            return p.value;
          }catch(e){localStorage.removeItem(key);return null;}
        }
        function saveConsent(val){
          localStorage.setItem(key,JSON.stringify({value:val,timestamp:Date.now()}));
        }
        function showBanner(){
          banner.style.display='flex';
          document.body.style.paddingBottom=(banner.offsetHeight||72)+'px';
          setTimeout(function(){document.getElementById('cookie-accept').focus();},100);
        }
        function hideBanner(){
          banner.style.display='none';
          document.body.style.paddingBottom='';
        }
        var consent=loadConsent();
        if(consent===null){
          showBanner();
        }else{
          hideBanner();
        }
        document.getElementById('cookie-accept').addEventListener('click',function(){
          saveConsent('1');
          hideBanner();
          if(typeof gtag==='function')gtag('consent','update',{analytics_storage:'granted'});
        });
        document.getElementById('cookie-decline').addEventListener('click',function(){
          saveConsent('0');
          hideBanner();
        });
        document.addEventListener('keydown',function(e){
          if(e.key==='Escape'&&banner.style.display!=='none'){
            hideBanner();
          }
        });
        window.__showConsentBanner=function(){
          localStorage.removeItem(key);
          banner.style.display='flex';
          setTimeout(function(){document.getElementById('cookie-accept').focus();},100);
        };
      })();
    </script>

    <!-- Affiliate click tracking -->
    <script is:inline>
      document.addEventListener('click', function(e) {
        var link = e.target.closest('a[rel~="sponsored"]')
        if (!link) return
        if (typeof gtag !== 'function') return

        // Derive position from closest ancestor with a data-track attribute,
        // or fall back to a class-name heuristic
        var pos = 'body'
        var el = link
        while (el && el !== document.body) {
          var cls = el.className || ''
          if (cls.indexOf('verdict-box') > -1)      { pos = 'verdict_box'; break }
          if (cls.indexOf('quick-picks') > -1)       { pos = 'quick_picks'; break }
          if (cls.indexOf('product-card') > -1)      { pos = 'product_card'; break }
          if (cls.indexOf('comparison-hero') > -1)   { pos = 'comparison_hero'; break }
          if (cls.indexOf('pros-cons') > -1)         { pos = 'pros_cons'; break }
          el = el.parentElement
        }

        gtag('event', 'affiliate_click', {
          product_name: link.dataset.product || link.textContent.trim().slice(0, 60),
          link_position: pos,
          link_url: link.href
        })
      })
    </script>
  </body>
</html>
